awk '/^## /{insec=($0 ~ /^## Confirmed non-overnight/)?1:0; next} insec&&/^- id:[ ]/{id=$0; sub(/^- id:[ ]*/,"",id); next} insec&&/^[ ]+title:[ ]/{t=$0; sub(/^[ ]+title:[ ]*/,"",t); gsub(/[\t\037]/," ",t); printf "%s\037%s\n", id, t; id=""}' "$OVN" 2>/dev/null | while IFS="$US" read -r nid ntitle; do
  [ -z "$nid" ] && continue
  printf '<div class="noitem"><b>%s</b> &mdash; %s <span class="ov-badge">dedicated build</span></div>' "$nid" "$(fmt "$ntitle")"
done
printf '</div>'
# run history — last 5 from the Runs log
printf '<div class="ov-runs"><h3>Runs &mdash; last 5</h3>'
if [ -s "$TMP/ovruns" ]; then
  while IFS= read -r rl; do [ -z "$rl" ] && continue; rl2=$(printf '%s' "$rl" | sed 's/^-[ ]*//'); printf '<div class="ov-run">%s</div>' "$(fmt "$rl2")"; done < "$TMP/ovruns"
else
  printf '<div class="ov-empty">&mdash; no runs yet &mdash;</div>'
fi
printf '</div>'
# latest report slot
printf '<div class="ov-reportslot">'
ov_render_report
printf '</div>'
printf '</section>\n'

# ===== MOBILE CANON (new top-level section — after Overnight, before the surface "Program"; insertion point flippable) =====
printf '<section class="page" id="page-mobile-canon"><h1 class="page-h u-inkgold">Mobile canon</h1>'
build_mobile_canon
printf '</section>\n'

# ===== surface pages (22 + cross-cutting) =====
for s in $SURFACES $LAYERS; do
  f="$STUDIO/$s.md"
  rt=$(fm "$f" route); gr=$(fm "$f" ground); rfn=$(fm "$f" render_fn)
  nv=$(fm "$f" in_nav); st=$(qstate "$s"); rn=$(qrounds "$s"); mk=$(fm "$f" mockup); mo=$(fm "$f" mobile)
  [ -z "$rt" ] && rt='&mdash;'; [ -z "$rfn" ] && rfn='&mdash;'; [ -z "$gr" ] && gr='&mdash;'; [ -z "$nv" ] && nv='&mdash;'
  # mobile chip: ledger `mobile:` field -> desktop-only|reflowed|native; absent -> desktop-only; unknown -> warn prefix, never dropped
  [ -z "$mo" ] && mo='desktop-only'
  case "$mo" in
    desktop-only|reflowed|native) mocls="mob-$mo"; modisp="$mo";;
    *) mocls="mob-unknown"; modisp="&#9888; $mo";;
  esac
  # plain-English state phrase for the surface lead (computed from the ledger state)
  case "$st" in
    closed) sdesc="a <b>closed</b> surface";;
    built) sdesc="<b>built</b>, awaiting its felt pass";;
    building) sdesc="in an <b>active build</b>";;
    shaped) sdesc="<b>shaped</b> &mdash; a mockup is in hand";;
    scanned) sdesc="<b>scanned</b> &mdash; its gaps are catalogued";;
    *) sdesc="<b>not yet</b> through a studio round";;
  esac
  printf '<section class="page surface" id="s-%s">' "$s"
  printf '<div class="surf-head"><h1 class="page-h u-inkgold">%s</h1><span class="surf-slug">%s</span><span class="badge"><span class="u-orb %s"></span>%s &middot; %s rounds</span><span class="badge badge-mobile %s">%s</span></div>' "$(hname "$s")" "$s" "$(orbcls "$st")" "$st" "$rn" "$mocls" "$modisp"
  printf '<p class="surf-lead"><b>%s</b> is %s. The build facts fold below &mdash; then the plan items that route through it and its open-gap ledger.</p>' "$(hname "$s")" "$sdesc"
  printf '<details class="disclose facts-fold"><summary>Build facts &mdash; route, render, ground, nav</summary><div class="disclose-body"><div class="facts"><span><b>route</b> <code>%s</code></span><span><b>render</b> <code>%s</code></span><span><b>ground</b> %s</span><span><b>in nav</b> %s</span></div></div></details>' "$rt" "$rfn" "$gr" "$nv"
  # CONNECTED strip: plan items (Now/Next/Then) whose touches include this surface
  conn=$(awk -F"$US" -v me="$s" '$1==me{print $2}' "$TMP/conn")
  if [ -n "$conn" ]; then
    printf '<div class="connected"><span class="cl">connected</span>'
    printf '%s\n' "$conn" | while IFS= read -r ct; do [ -z "$ct" ] && continue; printf '<a href="#page-plan">%s</a>' "$(fmt "$ct")"; done
    printf '</div>'
  fi
  # MOCKUP link: rendered iff the surface frontmatter carries a `mockup:` line.
  # Stored repo-relative (docs/studio/mockups/<s>.html); the Builder lives at
  # docs/studio/builder.html, so the href is the mockup path minus docs/studio/.
  if [ -n "$mk" ]; then
    mkhref=$(printf '%s' "$mk" | sed 's#^docs/studio/##; s/ /%20/g')
    printf '<div class="surf-mock"><a class="mock-link" href="%s" target="_blank" rel="noopener">&#10022; view mockup &middot; %s</a></div>' "$mkhref" "$(fmt "$mk")"
  fi
  printf '<div class="md md-surface" data-md="%s.md"></div>' "$s"
  printf '</section>\n'
done

# ===== mockups =====
printf '<section class="page" id="page-mockups"><h1 class="page-h u-inkgold">Mockups</h1><p class="ov-lead">Layout and style references for each surface &mdash; the shaped target a build realizes. Linked, never embedded.</p><div class="mock-list">'
for m in "$REPO"/design/*.html; do [ -e "$m" ] || continue; b=$(basename "$m"); enc=$(printf '%s' "$b" | sed 's/ /%20/g')
  printf '<a class="mock-link" href="../../design/%s" target="_blank" rel="noopener">%s</a>' "$enc" "$b"; done
printf '</div></section>\n'

# ===== about =====
printf '<section class="page" id="page-index"><div class="md" data-md="INDEX.md"></div></section>\n'

printf '</main>\n'

# ---- markdown islands ----
printf '<div class="md-islands" hidden aria-hidden="true">\n'
printf '<script type="text/markdown" data-md="INDEX.md">\n'; cat "$STUDIO/INDEX.md"; printf '\n</script>\n'
for s in $SURFACES $LAYERS; do
  printf '<script type="text/markdown" data-md="%s.md">\n' "$s"; cat "$STUDIO/$s.md"; printf '\n</script>\n'
done
printf '</div>\n'

# ---- client JS (ES3): surface-md render + cardify + sev dots + ticks + nav ----
cat <<'HTML'
<script>
(function(){
  function ls(k,d){ try{ var v=localStorage.getItem(k); return v===null?d:JSON.parse(v);}catch(e){return d;} }
  function sv(k,v){ try{ localStorage.setItem(k,JSON.stringify(v)); }catch(e){} }
  function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function inline(s){ s=esc(s);
    s=s.replace(/`([^`]+)`/g,function(m,a){return '<code>'+a+'</code>';});
    s=s.replace(/\*\*([^*<]+)\*\*/g,function(m,a){return '<strong>'+a+'</strong>';});
    s=s.replace(/\*([^*<]+)\*/g,function(m,a){return '<em>'+a+'</em>';});
    s=s.replace(/\[\[([^\]]+)\]\]/g,function(m,a){return '<a href="#s-'+a+'">'+a+'</a>';});
    s=s.replace(/\[([^\]]+)\]\(([^)]+)\)/g,function(m,t,u){return '<a href="'+u+'" target="_blank" rel="noopener">'+t+'</a>';});
    return s; }
  function renderMd(src){ src=src.replace(/\r\n/g,'\n').replace(/^\n+/,'');
    var mm=src.match(/^---\n([\s\S]*?)\n---\n?/); if(mm){src=src.slice(mm[0].length);}
    var lines=src.split('\n'),out='',i,listTag='',para=[];
    function closeList(){ if(listTag){ out+=(listTag==='ol'?'</ol>':'</ul>'); listTag=''; } }
    function flush(){ if(para.length){ out+='<p>'+inline(para.join(' '))+'</p>'; para=[]; } }
    for(i=0;i<lines.length;i++){ var t=lines[i].replace(/\s+$/,'');
      if(t===''){ flush(); closeList(); continue; }
      var h=t.match(/^(#{1,3})\s+(.*)$/);
      if(h){ flush(); closeList(); out+='<h'+h[1].length+' class="md-h'+h[1].length+'">'+inline(h[2])+'</h'+h[1].length+'>'; continue; }
      if(/^-{3,}$/.test(t)){ flush(); closeList(); out+='<hr>'; continue; }
      var b=t.match(/^[-*]\s+(.*)$/);
      if(b){ flush(); if(listTag!=='ul'){ closeList(); out+='<ul class="md-ul">'; listTag='ul'; } out+='<li>'+inline(b[1])+'</li>'; continue; }
      var o=t.match(/^\d+\.\s+(.*)$/);
      if(o){ flush(); if(listTag!=='ol'){ closeList(); out+='<ol class="md-ol">'; listTag='ol'; } out+='<li>'+inline(o[1])+'</li>'; continue; }
      para.push(t.replace(/^\s+/,'')); }
    flush(); closeList(); return out; }

  function collectIslands(){ var map={},sc=document.getElementsByTagName('script'),i;
    for(i=0;i<sc.length;i++){ if(sc[i].getAttribute('type')==='text/markdown'){ map[sc[i].getAttribute('data-md')]=sc[i].textContent||sc[i].text; } } return map; }
  function paint(is){ var hosts=document.querySelectorAll('.md[data-md]'),i;
    for(i=0;i<hosts.length;i++){ hosts[i].innerHTML=renderMd(is[hosts[i].getAttribute('data-md')]||''); } }

  function cardify(){ var hosts=document.querySelectorAll('.md-surface'),i;
    for(i=0;i<hosts.length;i++){ (function(host){
      var kids=[],n; for(n=host.firstChild;n;n=n.nextSibling) kids.push(n);
      var frag=document.createDocumentFragment(),body=null,j;
      for(j=0;j<kids.length;j++){ var el=kids[j];
        if(el.nodeType===1&&el.tagName==='H2'){ var card=document.createElement('section'); card.className='bcard u-gild-hairline'; card.appendChild(el);
          body=document.createElement('div'); body.className='bcard-body'; card.appendChild(body); frag.appendChild(card); }
        else if(body){ body.appendChild(el); } else { frag.appendChild(el); } }
      var cards=frag.querySelectorAll('.bcard');
      for(j=0;j<cards.length;j++){ var bd=cards[j].getElementsByClassName('bcard-body')[0];
        if(!bd||(bd.textContent||'').replace(/\s+/g,'')===''){ cards[j].className+=' bcard-empty'; if(bd){ bd.innerHTML='<span class="bcard-none">no entries yet</span>'; } } }
      host.innerHTML=''; host.appendChild(frag);
    })(hosts[i]); } }

  function sevDots(){ var lis=document.querySelectorAll('.md-surface li'),i;
    for(i=0;i<lis.length;i++){ var tx=lis[i].textContent||''; if(tx.indexOf('[source:')<0) continue;
      var m=tx.match(/\[sev:\s*([A-Za-z0-9-]+)/); var cls='sevdot';
      if(m){ var v=m[1].toLowerCase();
        if(v==='critical') cls='sevdot sev-critical'; else if(v==='high') cls='sevdot sev-high';
        else if(v==='medium') cls='sevdot sev-medium'; else if(v==='low') cls='sevdot sev-low'; }
      var dot=document.createElement('span'); dot.className=cls; lis[i].insertBefore(dot,lis[i].firstChild); } }

  function wireTicks(){ var boxes=document.querySelectorAll('.ptick-box'),i;
    for(i=0;i<boxes.length;i++){ (function(box){ var k='studio_ptick_'+box.getAttribute('data-key');
      box.checked=ls(k,false); box.onchange=function(){ sv(k,box.checked); }; })(boxes[i]); } }

  function addcls(c,x){ return (' '+c+' ').indexOf(' '+x+' ')>-1?c:(c?c+' '+x:x); }
  function rmcls(c,x){ return (' '+c+' ').replace(' '+x+' ',' ').replace(/^\s+|\s+$/g,''); }
  function showPage(){ var h=location.hash||'#page-overview',id=h.replace(/^#/,''),rawid=id,anchor=null;
    // in-page anchor support (e.g. #now, #surfaces from the top nav): if the hash points
    // at a non-.page element, resolve to its containing .page and remember it to scroll to.
    // Page hashes are unaffected — the block is a no-op for any element carrying class "page".
    try{ var el=document.getElementById(id);
      if(el&&(' '+el.className+' ').indexOf(' page ')<0){
        var p=el.parentNode; while(p&&p.nodeType===1){ if((' '+(p.className||'')+' ').indexOf(' page ')>-1){ id=p.id; anchor=el; break; } p=p.parentNode; } }
    }catch(e){ anchor=null; }
    var pages=document.querySelectorAll('.page'),i,found=false;
    for(i=0;i<pages.length;i++){ if(pages[i].id===id){ pages[i].className=addcls(pages[i].className,'active'); found=true; } else { pages[i].className=rmcls(pages[i].className,'active'); } }
    if(!found){ var ov=document.getElementById('page-overview'); if(ov){ ov.className=addcls(ov.className,'active'); } id='page-overview'; }
    var links=document.querySelectorAll('.brail-link'),href;
    for(i=0;i<links.length;i++){ href=links[i].getAttribute('href')||''; if(href==='#'+id){ links[i].className=addcls(links[i].className,'active'); } else { links[i].className=rmcls(links[i].className,'active'); } }
    var tns=document.querySelectorAll('.topnav-link'),thref;
    for(i=0;i<tns.length;i++){ thref=tns[i].getAttribute('href')||''; if(thref==='#'+rawid){ tns[i].className=addcls(tns[i].className,'active'); } else { tns[i].className=rmcls(tns[i].className,'active'); } }
    if(anchor&&anchor.scrollIntoView){ try{ anchor.scrollIntoView(); }catch(e){ window.scrollTo(0,0); } } else { window.scrollTo(0,0); } }

  function boot(){ var is=collectIslands(); paint(is); cardify(); sevDots(); wireTicks(); showPage(); window.onhashchange=showPage; }
  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded',boot); } else { boot(); }
})();
</script>
</body>
</html>
HTML
} > "$OUT"

echo "studio-build: wrote $OUT  (HEAD $HEAD, $CACHE, $NOW; closed $CLOSED/$TOTAL, gaps $TOTALGAPS, ship $SHIPCOUNT, map $MAPCOUNT)"

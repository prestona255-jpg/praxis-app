body{color:var(--ink);font-family:var(--sans);font-size:15.5px;line-height:1.62;
  background-color:#eaddb4;
  background-image:
    radial-gradient(46% 40% at 16% 6%, rgba(248,228,176,.5), transparent 60%),
    radial-gradient(44% 44% at 88% 14%, rgba(232,200,135,.38), transparent 66%),

.stat-fill{height:100%;min-width:3px;background:linear-gradient(90deg,var(--gold-hi),var(--field-1),var(--gold-hi));box-shadow:0 0 8px rgba(217,164,65,.5);border-radius:999px;}

/* -- disclosure: fold technical detail behind a tap (44px target) -- */
.disclose{margin:11px 0 8px;border:1px solid var(--line);border-radius:11px;background:var(--surface);overflow:hidden;}
.disclose>summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:9px;min-height:44px;padding:0 15px;font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--gold-deep);}

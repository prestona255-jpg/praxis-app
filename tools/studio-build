  background:var(--surface);border-right:1px solid var(--line);box-shadow:1px 0 0 rgba(217,164,65,.25);padding:14px 12px 44px;}
.brail-brand{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-deep);padding:4px 10px 6px;}
.brail-group{font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3);margin:16px 10px 6px;}
.brail-link{display:flex;align-items:center;gap:9px;font-family:var(--sans);font-size:13px;color:var(--ink-2);text-decoration:none;padding:6px 10px;border-radius:9px;border-left:2px solid transparent;transition:background .18s,color .18s;}
.brail-link:hover{background:var(--surface-2);color:var(--gold-deep);}

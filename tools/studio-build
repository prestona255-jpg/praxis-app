#!/bin/sh
# tools/studio-build -- Praxis Studio Builder generator (v3). EXTENSIONLESS on
# purpose (like tools/parse-check): the pre-commit hook treats any top-level *.js
# as served source that must ride a sw.js bump; this build tool is never served.
#
# v3: Overview (heat grid + NOW card) is the landing; the Plan page renders the
# sequence as a gilded THREAD with a reach-map SVG; surfaces carry human names.
# EVERYTHING is computed at build time (no layout JS): the client script only
# renders the surface-markdown islands, wires personal ticks, and drives nav.
#
# docs/studio/universal-depth.css (Universal depth v1.2) is the single app-wide
# law and is INLINED byte-identical; Builder-only layout CSS lives HERE, not there.
#
# Usage:  sh tools/studio-build     (CWD-independent)

SDIR=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$SDIR/.." && pwd)
STUDIO="$REPO/docs/studio"
DEPTH="$STUDIO/universal-depth.css"
SEQ="$STUDIO/sequence.md"
OUT="$STUDIO/builder.html"
US=$(printf '\037')   # field delimiter — non-whitespace so empty fields (e.g. no touches) are preserved by read

# 22 surfaces (18 routed + 4 overlay); cross-cutting is a layer, not a surface.
SURFACES="home books book-detail book-marks artifact arcs arc-detail subtheory-page subtheory-build notebook account about profile commons reader walk search yumi-sees yumi-panel onboarding import-capture spotlight"
LAYERS="cross-cutting"

# layer groups (slug lists) + display order
G_CORE="home about search spotlight"
G_READING="books book-detail book-marks artifact"
G_WRITING="arcs arc-detail subtheory-page subtheory-build notebook import-capture"
G_SOCIAL="account profile commons reader walk"
G_YUMI="yumi-panel yumi-sees onboarding"
G_SYSTEM="cross-cutting"

# ground-truth stamp values (baked at generation time)
HEAD=$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo '?')
CACHE=$(grep -oE "CACHE_VERSION *= *'[^']*'" "$REPO/sw.js" 2>/dev/null | head -1 | sed "s/.*'\(.*\)'/\1/")
[ -z "$CACHE" ] && CACHE='?'
NOW=$(date -u '+%Y-%m-%d %H:%M UTC')

# --- helpers ---
fm() { grep -m1 "^$2:" "$1" | sed "s/^$2:[[:space:]]*//; s/^\"//; s/\"$//"; }
gapcount() { c=$(grep -c '^- \[source: ' "$STUDIO/$1.md" 2>/dev/null); [ -z "$c" ] && c=0; echo "$c"; }
has_brief() { awk '/^## Next/{f=1;next} /^## /{f=0} f&&NF{print}' "$STUDIO/$1.md" 2>/dev/null | grep -q '[^[:space:]]' && echo 1 || echo 0; }
# state -> luminous-orb modifier classes (bright=closed, soft=in a round, unlit=untouched)
orbcls() { case "$1" in
  closed) echo "u-orb--lit u-orb--amber";;
  building) echo "u-orb--soft u-orb--coral";;
  shaped) echo "u-orb--soft u-orb--amber";;
  scanned) echo "u-orb--soft u-orb--periwinkle";;
  *) echo "u-orb--unlit";; esac; }
# slug -> human name
hname() { case "$1" in
  home) echo "Home";; about) echo "About";; search) echo "Search";; spotlight) echo "Spotlight";;
  books) echo "Shelf";; book-detail) echo "Book";; book-marks) echo "Marks &amp; lineage";; artifact) echo "Artifact";;
  arcs) echo "Arcs";; arc-detail) echo "Arc";; subtheory-page) echo "Sub-theory page";; subtheory-build) echo "Sub-theory build";; notebook) echo "Notebook";; import-capture) echo "Import &amp; capture";;
  account) echo "Account";; profile) echo "Profile";; commons) echo "Commons";; reader) echo "Reader";; walk) echo "Walk";;
  yumi-panel) echo "Yumi panel";; yumi-sees) echo "What Yumi sees";; onboarding) echo "Onboarding";;
  cross-cutting) echo "Cross-cutting";; *) echo "$1";; esac; }
# slug -> layer field hue (reach-map orbs)
layerhue() { case "$1" in
  home|about|search|spotlight) echo "#f2c25a";;
  books|book-detail|book-marks|artifact) echo "#e07a52";;
  arcs|arc-detail|subtheory-page|subtheory-build|notebook|import-capture) echo "#a9b98c";;
  account|profile|commons|reader|walk) echo "#8590d8";;
  yumi-panel|yumi-sees|onboarding) echo "#f8e078";;
  cross-cutting) echo "#b8896c";; *) echo "#f2c25a";; esac; }
# a stable localStorage key from a title
slug() { printf '%s' "$1" | tr 'A-Z' 'a-z' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-48; }
# minimal inline markdown -> HTML (escape first, then code/bold/em)
fmt() { printf '%s' "$1" | sed -E \
  -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' \
  -e 's/`([^`]+)`/<code>\1<\/code>/g' \
  -e 's/\*\*([^*<]+)\*\*/<strong>\1<\/strong>/g' \
  -e 's/\*([^*<]+)\*/<em>\1<\/em>/g'; }

# parse checkbox items of a section -> "title <TAB> touches <TAB> body" per item
parse_items() {
awk -v sec="$1" '
function emit(){ if(have){ gsub(/[\t\037]/," ",body); gsub(/[\t\037]/," ",title); printf "%s\037%s\037%s\n", title, touches, body; have=0; title=""; touches=""; body="" } }
BEGIN{insec=0;have=0}
/^## /{ emit(); insec=($0 ~ ("^## " sec "([ ]|$)"))?1:0; next }
insec==0{ next }
/^- \[[ xX]\]/{ emit(); line=$0; sub(/^- \[[ xX]\][ ]+/,"",line); title=line;
  if(match(line,/\*\*[^*]+\*\*/)){ title=substr(line,RSTART+2,RLENGTH-4) } body=line; have=1; next }
/^[ ]+touches:/{ if(have){ t=$0; sub(/^[ ]+touches:[ ]*\[?/,"",t); sub(/\].*/,"",t); touches=t } next }
/^[ ]+[^ ]/{ if(have){ c=$0; sub(/^[ ]+/,"",c); body=body " " c } next }
/^[[:space:]]*$/{ emit(); next }
END{ emit() }
' "$SEQ"
}
# parse non-checkbox bullets -> "kind <TAB> body" (kind = PROPOSED|normal)
parse_bullets() {
awk -v sec="$1" '
function emit(){ if(have){ gsub(/[\t\037]/," ",body); printf "%s\037%s\n", kind, body; have=0; body=""; kind="normal" } }
BEGIN{insec=0;have=0;kind="normal"}
/^## /{ emit(); insec=($0 ~ ("^## " sec))?1:0; next }
insec==0{ next }
/^- /{ emit(); line=$0; sub(/^- /,"",line); kind=(line ~ /^PROPOSED:/)?"PROPOSED":"normal"; body=line; have=1; next }
/^[ ]+[^ ]/{ if(have){ c=$0; sub(/^[ ]+/,"",c); body=body " " c } next }
/^[[:space:]]*$/{ emit(); next }
END{ emit() }
' "$SEQ"
}
collect_touches() { awk -F"$US" '{print $2}' "$TMP/$1" | tr ',' '\n' | sed 's/[][ ]//g' | grep -v '^$' | sort -u; }

# --- precompute ONCE (Windows subprocess spawns are costly; do the awk/grep work here) ---
TMP=$(mktemp -d 2>/dev/null || { d="${TMPDIR:-/tmp}/studiobuild.$$"; mkdir -p "$d"; printf '%s' "$d"; })
trap 'rm -rf "$TMP"' EXIT INT TERM
parse_items Now > "$TMP/now"; parse_items Next > "$TMP/next"; parse_items Then > "$TMP/then"
parse_items Shipped > "$TMP/shipped"; parse_items Discovered > "$TMP/disc"
parse_bullets "Re-plan log" > "$TMP/replan"; parse_bullets "Standing rules" > "$TMP/standing"; parse_bullets "Open calls" > "$TMP/opencalls"
# per-surface caches in one pass -> pure-shell lookups (no exec per query)
GAPS=""; BRIEFS=""; STATES=""; ROUNDS=""; CLOSED=0; TOTALGAPS=0
for s in $SURFACES $LAYERS; do
  g=$(gapcount "$s"); GAPS="$GAPS $s:$g"; TOTALGAPS=$((TOTALGAPS+g))
  BRIEFS="$BRIEFS $s:$(has_brief "$s")"
  x=$(fm "$STUDIO/$s.md" state); [ -z "$x" ] && x=untouched; STATES="$STATES $s:$x"; [ "$x" = "closed" ] && CLOSED=$((CLOSED+1))
  y=$(fm "$STUDIO/$s.md" rounds); [ -z "$y" ] && y=0; ROUNDS="$ROUNDS $s:$y"
done
qgap(){ t=" $GAPS "; t="${t##* $1:}"; printf '%s' "${t%% *}"; }
qbrief(){ t=" $BRIEFS "; t="${t##* $1:}"; printf '%s' "${t%% *}"; }
qstate(){ t=" $STATES "; t="${t##* $1:}"; printf '%s' "${t%% *}"; }
qrounds(){ t=" $ROUNDS "; t="${t##* $1:}"; printf '%s' "${t%% *}"; }
# connected reverse map (built once): touched-slug <US> item-title
awk -F"$US" -v us="$US" '{ n=split($2,a,","); for(k=1;k<=n;k++){ gsub(/[][ ]/,"",a[k]); if(a[k]!=""){ printf "%s%s%s\n", a[k], us, $1 } } }' "$TMP/now" "$TMP/next" "$TMP/then" > "$TMP/conn"

# --- computed numbers ---
set -- $SURFACES; TOTAL=$#
SHIPCOUNT=$(grep -c . "$TMP/shipped")
PCT=0; [ "$TOTAL" -gt 0 ] && PCT=$((CLOSED*100/TOTAL))
LAUNCHLINE=$(grep -m1 'Flexible launch date' "$SEQ" | sed -E 's/.*\*\*[^*]*\*\*[ ]*//; s/;.*//; s/\.$//')
[ -z "$LAUNCHLINE" ] && LAUNCHLINE="flexible launch, no hard clock"
NOW_TOUCH=$(collect_touches now)
NEXT_TOUCH=$(collect_touches next)
# reach-map surface set = union of Now/Next touches, capped at 8 by highest gapcount
MAP_RAW=$(printf '%s\n%s\n' "$NOW_TOUCH" "$NEXT_TOUCH" | sort -u | grep -v '^$')
MAP=""
if [ -n "$MAP_RAW" ]; then
  MAP=$(for s in $MAP_RAW; do printf '%s %s\n' "$(qgap "$s")" "$s"; done | sort -rn | head -8 | awk '{print $2}')
fi
MAPCOUNT=$(printf '%s\n' "$MAP" | grep -c .)

# reach-map SVG (single dark element in the Builder)
build_reachmap() {
  printf '<svg viewBox="0 0 960 360" class="reach-svg" role="img" aria-label="The plan thread and the surfaces the Now and Next moves reach">'
  # gold thread arc + 5 fixed nodes
  printf '<path d="M80 92 Q480 20 880 92" fill="none" stroke="url(#threadg)" stroke-width="2.5"/>'
  printf '<defs><linearGradient id="threadg" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#8a5a12"/><stop offset="0.5" stop-color="#ffce4a"/><stop offset="1" stop-color="#8a5a12"/></linearGradient>'
  printf '<radialGradient id="nowg" cx="0.35" cy="0.3" r="0.7"><stop offset="0" stop-color="#fff4d6"/><stop offset="0.55" stop-color="#f2c25a"/><stop offset="1" stop-color="#8a5a12"/></radialGradient></defs>'
  # nodes: SHIPPED NOW NEXT THEN LAUNCH at fixed points along the arc
  set -- "SHIPPED 80 92 6" "NOW 280 54 9" "NEXT 480 41 6" "THEN 680 54 5" "LAUNCH 880 92 7"
  for node in "$@"; do
    nm=$(echo "$node" | cut -d' ' -f1); nx=$(echo "$node" | cut -d' ' -f2); ny=$(echo "$node" | cut -d' ' -f3); nr=$(echo "$node" | cut -d' ' -f4)
    if [ "$nm" = "LAUNCH" ]; then
      printf '<a href="#page-plan"><circle cx="%s" cy="%s" r="%s" fill="none" stroke="#ffce4a" stroke-width="2"/><text x="%s" y="%s" text-anchor="middle" class="rm-node">%s</text></a>' "$nx" "$ny" "$nr" "$nx" "$((ny-16))" "$nm"
    else
      fill="#e9d6a8"; [ "$nm" = "NOW" ] && fill="url(#nowg)"
      glow=""; [ "$nm" = "NOW" ] && glow=' filter="url(#nowglow)"'
      printf '<a href="#page-plan"><circle cx="%s" cy="%s" r="%s" fill="%s"%s/><text x="%s" y="%s" text-anchor="middle" class="rm-node">%s</text></a>' "$nx" "$ny" "$nr" "$fill" "$glow" "$nx" "$((ny-16))" "$nm"
    fi
  done
  printf '<filter id="nowglow" x="-100%%" y="-100%%" width="300%%" height="300%%"><feGaussianBlur stdDeviation="3"/></filter>'
  if [ "$MAPCOUNT" -eq 0 ]; then
    printf '<text x="480" y="250" text-anchor="middle" class="rm-cold">no reach data yet &mdash; touches appear as rounds are planned</text>'
  else
    # assign fixed slot x to each mapped surface
    n=$MAPCOUNT; i=0; SLOTS=""
    for s in $MAP; do
      if [ "$n" -le 1 ]; then x=480; else x=$((120 + i*720/(n-1))); fi
      SLOTS="$SLOTS $s:$x"; i=$((i+1))
    done
    # lines: bright from NOW (280,54), faint from NEXT (480,41)
    for pair in $SLOTS; do s=${pair%%:*}; x=${pair##*:}
      if printf '%s\n' $NOW_TOUCH | grep -qx "$s"; then
        printf '<line x1="280" y1="54" x2="%s" y2="272" stroke="#ffce4a" stroke-width="2" opacity="0.8"/>' "$x"
      elif printf '%s\n' $NEXT_TOUCH | grep -qx "$s"; then
        printf '<line x1="480" y1="41" x2="%s" y2="272" stroke="#e9b24a" stroke-width="1.2" opacity="0.32"/>' "$x"
      fi
    done
    # orbs
    for pair in $SLOTS; do s=${pair%%:*}; x=${pair##*:}; hue=$(layerhue "$s"); g=$(qgap "$s")
      printf '<a href="#s-%s"><circle cx="%s" cy="284" r="13" fill="%s" opacity="0.95"/><circle cx="%s" cy="284" r="20" fill="%s" opacity="0.16"/><text x="%s" y="316" text-anchor="middle" class="rm-orb">%s &middot; %s</text></a>' "$s" "$x" "$hue" "$x" "$hue" "$x" "$(hname "$s")" "$g"
    done
  fi
  printf '</svg>'
  printf '<div class="rm-caption">GOLD THREAD = THE PLAN &middot; BRIGHT LINE = THE NOW MOVE&rsquo;S REACH &middot; ORBS = SURFACES, COLOR = LAYER</div>'
}

# render the sidebar group of surfaces
brail_group() {
  printf '<div class="brail-group">%s</div>' "$1"; shift
  for s in "$@"; do
    st=$(qstate "$s")
    g=$(qgap "$s"); gc=''; [ "$g" -gt 0 ] && gc='<span class="brail-count">'"$g"'</span>'
    bf=''; [ "$(qbrief "$s")" = "1" ] && bf='<span class="brief-star" title="brief ready">&#10022;</span>'
    printf '<a class="brail-link brail-surf" href="#s-%s"><span class="u-orb %s"></span><span class="brail-slug">%s</span>%s%s</a>' "$s" "$(orbcls "$st")" "$(hname "$s")" "$bf" "$gc"
  done
}

# render one balanced thread node: class orbclass body touches title wrap(card|"")
render_node() {
  ncls="$1"; oc="$2"; nbody="$3"; ntou="$4"; ntitle="$5"; nwrap="$6"
  printf '<div class="tnode %s"><span class="dot"><span class="u-orb %s"></span></span><div class="trow"><div class="tmain">' "$ncls" "$oc"
  [ "$nwrap" = "card" ] && printf '<div class="tcard u-lamplight">'
  printf '<div class="tsent">%s</div>' "$(fmt "$nbody")"
  if [ -n "$ntou" ]; then
    printf '<div class="touches">'; j=0
    printf '%s\n' "$ntou" | tr ',' '\n' | sed 's/[][ ]//g' | grep -v '^$' | while read -r ts; do
      cc="touch-chip"; [ "$j" -eq 0 ] && cc="touch-chip primary"
      printf '<a class="%s" href="#s-%s"><span class="tc-dot">&#9673;</span>%s &middot; %s</a>' "$cc" "$ts" "$(hname "$ts")" "$(qgap "$ts")"; j=$((j+1))
    done
    printf '</div>'
  fi
  [ "$nwrap" = "card" ] && printf '</div>'
  printf '</div><label class="ptick"><input type="checkbox" class="ptick-box" data-key="%s"><span>your ticks</span></label></div></div>' "$(slug "$ntitle")"
}

# render the heat-grid group
heat_group() {
  printf '<div class="heat-glabel">%s</div><div class="heat-row">' "$1"; shift
  for s in "$@"; do
    st=$(qstate "$s")
    rn=$(qrounds "$s")
    g=$(qgap "$s")
    bf=''; [ "$(qbrief "$s")" = "1" ] && bf=' <span class="brief-star" title="brief ready">&#10022;</span>'
    printf '<a class="heat-tile u-gild-hairline" href="#s-%s"><span class="u-orb %s"></span><span class="heat-name">%s%s</span><span class="heat-meta">%s GAPS &middot; %s ROUNDS</span></a>' "$s" "$(orbcls "$st")" "$(hname "$s")" "$bf" "$g" "$rn"
  done
  printf '</div>'
}

{
# ---- head + base tokens + Builder layout CSS ----
cat <<'HTML'

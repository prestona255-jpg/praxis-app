HTML

# ---- INLINE the single canonical depth stylesheet (Universal depth v1.2) ----
printf '<style id="universal-depth">\n'
if [ -f "$DEPTH" ]; then cat "$DEPTH"; else echo "/* universal-depth.css MISSING at generation time */"; fi
printf '\n</style>\n</head>\n<body>\n'

# ---- stamp strip (dynamic) ----
printf '<header class="bstamp"><span class="bstamp-brand">Praxis Studio &middot; Builder</span> <span class="bstamp-facts">HEAD <code>%s</code> &middot; <code>%s</code> &middot; generated %s</span> <span class="bstamp-note">a generated view of the markdown &mdash; if this HEAD differs from the repo, the view is stale</span></header>\n' "$HEAD" "$CACHE" "$NOW"

# ---- sidebar rail (dynamic) ----
printf '<nav class="brail">'
printf '<div class="brail-brand">the studio</div>'
printf '<div class="brail-top">'
printf '<a class="brail-link" href="#page-overview">Overview</a>'
printf '<a class="brail-link" href="#page-sequence">Sequence</a>'
printf '<a class="brail-link" href="#page-mockups">Mockups</a>'
printf '<a class="brail-link" href="#page-index">About</a>'
printf '</div>'
printf '<div class="brail-group">surfaces</div>'
for s in $SURFACES; do
  st=$(fm "$STUDIO/$s.md" state); [ -z "$st" ] && st=untouched
  g=$(gapcount "$s"); gc=''; [ "$g" -gt 0 ] && gc='<span class="brail-count">'"$g"'</span>'
  printf '<a class="brail-link brail-surf" href="#s-%s"><span class="u-orb %s"></span><span class="brail-slug">%s</span>%s</a>' "$s" "$(orbcls "$st")" "$s" "$gc"
done
printf '<div class="brail-group">layer</div>'
for s in $LAYERS; do
  st=$(fm "$STUDIO/$s.md" state); [ -z "$st" ] && st=untouched
  g=$(gapcount "$s"); gc=''; [ "$g" -gt 0 ] && gc='<span class="brail-count">'"$g"'</span>'
  printf '<a class="brail-link brail-surf" href="#s-%s"><span class="u-orb %s"></span><span class="brail-slug">%s</span>%s</a>' "$s" "$(orbcls "$st")" "$s" "$gc"
done
printf '</nav>\n'

printf '<main>\n'

# ---- overview page (DEFAULT landing) ----
printf '<section class="page" id="page-overview"><h2 class="page-h u-inkgold">Surface overview</h2><p class="muted">All %s surfaces + the cross-cutting layer, state-colored. untouched &middot; scanned &middot; shaped &middot; building &middot; closed.</p>' "$TOTAL"
printf '<div class="progress"><div class="pbar"><div class="pfill" style="width:%s%%"></div></div><div class="plab"><b>%s</b> of %s surfaces closed &middot; <b>%s</b> shipped steps</div></div>' "$PCT" "$CLOSED" "$TOTAL" "$SHIPPED"
printf '<div class="ov-grid">'
for s in $SURFACES $LAYERS; do
  st=$(fm "$STUDIO/$s.md" state); [ -z "$st" ] && st=untouched
  rn=$(fm "$STUDIO/$s.md" rounds); [ -z "$rn" ] && rn=0
  g=$(gapcount "$s"); gc=''; [ "$g" -gt 0 ] && gc=' &middot; <span class="ov-gaps">'"$g"' gaps</span>'
  printf '<a class="ov-cell u-gild-hairline" href="#s-%s"><span class="u-orb %s"></span><span class="ov-meta"><span class="ov-slug">%s</span><span class="ov-state">%s &middot; %s rounds%s</span></span></a>' "$s" "$(orbcls "$st")" "$s" "$st" "$rn" "$gc"
done
printf '</div></section>\n'

# ---- sequence page: progress + recent strip (seeded) + legend + body ----
printf '<section class="page" id="page-sequence"><h2 class="page-h u-inkgold">The build sequence</h2>\n'
printf '<div class="progress"><div class="pbar"><div class="pfill" style="width:%s%%"></div></div><div class="plab"><b>%s</b> of %s surfaces closed &middot; <b>%s</b> shipped steps</div></div>' "$PCT" "$CLOSED" "$TOTAL" "$SHIPPED"
printf '<div class="recent-strip" id="recent-strip"><span class="rs-label">recent</span>'
grep -E '^- \[x\] ' "$STUDIO/sequence.md" | head -5 | sed -E 's/^- \[x\] //' | while IFS= read -r line; do
  title=$(printf '%s' "$line" | sed -E 's/^\*\*([^*]+)\*\*.*/\1/')
  printf '<span class="rs-item">sequence &middot; %s &middot; shipped</span>' "$title"
done
printf '</div>\n'
printf '<div class="tick-legend"><b>&#9675; / &#10003;</b> the record (changes only at a round close) &nbsp;&middot;&nbsp; <b>&#9744;</b> your ticks &mdash; not the record (saved in this browser)</div>\n'
printf '<div class="md" id="seq-body" data-md="sequence.md"></div>\n'
printf '</section>\n'

# ---- surface pages (22 surfaces + the cross-cutting layer) ----
for s in $SURFACES $LAYERS; do
  f="$STUDIO/$s.md"
  rt=$(fm "$f" route); gr=$(fm "$f" ground); rfn=$(fm "$f" render_fn)
  nv=$(fm "$f" in_nav); st=$(fm "$f" state); rn=$(fm "$f" rounds)
  [ -z "$st" ] && st=untouched; [ -z "$rn" ] && rn=0
  [ -z "$rt" ] && rt='&mdash;'; [ -z "$rfn" ] && rfn='&mdash;'; [ -z "$gr" ] && gr='&mdash;'; [ -z "$nv" ] && nv='&mdash;'
  printf '<section class="page surface" id="s-%s">' "$s"
  printf '<div class="surf-head"><h2 class="page-h u-inkgold">%s</h2><span class="badge"><span class="u-orb %s"></span>%s &middot; %s rounds</span></div>' "$s" "$(orbcls "$st")" "$st" "$rn"
  printf '<div class="facts"><span><b>route</b> <code>%s</code></span><span><b>render</b> <code>%s</code></span><span><b>ground</b> %s</span><span><b>in nav</b> %s</span></div>' "$rt" "$rfn" "$gr" "$nv"
  printf '<div class="md md-surface" data-md="%s.md"></div>' "$s"
  printf '</section>\n'
done

# ---- mockups page (LINKS only, never embedded) ----
printf '<section class="page" id="page-mockups"><h2 class="page-h u-inkgold">Mockups</h2><p class="muted">Layout / style references &mdash; linked, never embedded. Every design/*.html.</p><div class="mock-list">'
for m in "$REPO"/design/*.html; do
  [ -e "$m" ] || continue
  b=$(basename "$m")
  enc=$(printf '%s' "$b" | sed 's/ /%20/g')
  printf '<a class="mock-link" href="../../design/%s" target="_blank" rel="noopener">%s</a>' "$enc" "$b"
done
printf '</div></section>\n'

# ---- about/index page ----
printf '<section class="page" id="page-index"><div class="md" data-md="INDEX.md"></div></section>\n'

printf '</main>\n'

# ---- markdown islands (inert; the renderer reads these) ----
printf '<div class="md-islands" hidden aria-hidden="true">\n'
for f in sequence.md INDEX.md; do
  printf '<script type="text/markdown" data-md="%s">\n' "$f"
  cat "$STUDIO/$f"
  printf '\n</script>\n'
done
for s in $SURFACES $LAYERS; do
  printf '<script type="text/markdown" data-md="%s.md">\n' "$s"
  cat "$STUDIO/$s.md"
  printf '\n</script>\n'
done
printf '</div>\n'

# ---- app JS (ES3: renderer + nav + ticks + cards + collapse) ----
cat <<'HTML'
<script>
/* studio builder runtime -- ES3 (var/function, string concat, no template literals) */
(function(){
  document.documentElement.className = document.documentElement.className.replace(/\bjs-off\b/,'');

  function ls(k,d){ try{ var v=localStorage.getItem(k); return v===null?d:JSON.parse(v);}catch(e){return d;} }
  function sv(k,v){ try{ localStorage.setItem(k,JSON.stringify(v)); }catch(e){} }
  function keyOf(s){ var h=0,i; for(i=0;i<s.length;i++){ h=((h<<5)-h+s.charCodeAt(i))|0; } return (h>>>0).toString(36); }

  function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function inline(s){
    s = esc(s);
    s = s.replace(/`([^`]+)`/g, function(m,a){ return '<code>'+a+'</code>'; });
    s = s.replace(/\*\*([^*]+)\*\*/g, function(m,a){ return '<strong>'+a+'</strong>'; });
    s = s.replace(/\*([^*]+)\*/g, function(m,a){ return '<em>'+a+'</em>'; });
    s = s.replace(/\[\[([^\]]+)\]\]/g, function(m,a){ return '<a href="#s-'+a+'">'+a+'</a>'; });
    s = s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, function(m,t,u){ return '<a href="'+u+'" target="_blank" rel="noopener">'+t+'</a>'; });
    return s;
  }
  function renderMd(src){
    src = src.replace(/\r\n/g,'\n').replace(/^\n+/,'');
    var mm=src.match(/^---\n([\s\S]*?)\n---\n?/);
    if(mm){ src=src.slice(mm[0].length); }
    var lines=src.split('\n'), out='', i;
    var listTag='', para=[];
    function closeList(){ if(listTag){ var tag=(listTag==='ol'?'ol':'ul'); out+='</'+tag+'>'; listTag=''; } }
    function flush(){ if(para.length){ out+='<p>'+inline(para.join(' '))+'</p>'; para=[]; } }
    for(i=0;i<lines.length;i++){
      var t=lines[i].replace(/\s+$/,'');
      if(t===''){ flush(); closeList(); continue; }
      var h=t.match(/^(#{1,3})\s+(.*)$/);
      if(h){ flush(); closeList(); var lv=h[1].length; out+='<h'+lv+' class="md-h'+lv+'">'+inline(h[2])+'</h'+lv+'>'; continue; }
      if(/^-{3,}$/.test(t)){ flush(); closeList(); out+='<hr>'; continue; }
      var tk=t.match(/^[-*]\s+\[([ xX])\]\s+(.*)$/);
      if(tk){ flush(); if(listTag!=='ul-task'){ closeList(); out+='<ul class="md-tasks">'; listTag='ul-task'; }
        var done=(tk[1].toLowerCase()==='x'), txt=tk[2], k=keyOf(txt);
        out+='<li class="task '+(done?'done':'open')+'">'
           + '<span class="canon '+(done?'is-done':'')+'" title="the record">'+(done?'✓':'○')+'</span>'
           + '<span class="tasktext">'+inline(txt)+'</span>'
           + '<label class="ptick" title="your ticks - not the record"><input type="checkbox" class="ptick-box" data-key="'+k+'" aria-label="your ticks - not the record"><span>your ticks</span></label>'
           + '</li>'; continue; }
      var b=t.match(/^[-*]\s+(.*)$/);
      if(b){ flush(); if(listTag!=='ul'){ closeList(); out+='<ul class="md-ul">'; listTag='ul'; } out+='<li>'+inline(b[1])+'</li>'; continue; }
      var o=t.match(/^\d+\.\s+(.*)$/);
      if(o){ flush(); if(listTag!=='ol'){ closeList(); out+='<ol class="md-ol">'; listTag='ol'; } out+='<li>'+inline(o[1])+'</li>'; continue; }
      para.push(t.replace(/^\s+/,''));
    }
    flush(); closeList();
    return out;
  }

  function collectIslands(){
    var map={}, sc=document.getElementsByTagName('script'), i;
    for(i=0;i<sc.length;i++){ if(sc[i].getAttribute('type')==='text/markdown'){ map[sc[i].getAttribute('data-md')]=sc[i].textContent||sc[i].text; } }
    return map;
  }
  function paint(islands){
    var hosts=document.querySelectorAll('.md[data-md]'), i;
    for(i=0;i<hosts.length;i++){ var nm=hosts[i].getAttribute('data-md'); hosts[i].innerHTML=renderMd(islands[nm]||''); }
  }

  /* surface pages: split the rendered md into gilded-hairline cards per ## section; empty -> muted line */
  function cardify(){
    var hosts=document.querySelectorAll('.md-surface'), i;
    for(i=0;i<hosts.length;i++){ (function(host){
      var kids=[], n; for(n=host.firstChild;n;n=n.nextSibling) kids.push(n);
      var frag=document.createDocumentFragment(), body=null, j;
      for(j=0;j<kids.length;j++){ var el=kids[j];
        if(el.nodeType===1 && (el.tagName==='H2')){
          var card=document.createElement('section'); card.className='bcard u-gild-hairline';
          card.appendChild(el);
          body=document.createElement('div'); body.className='bcard-body'; card.appendChild(body);
          frag.appendChild(card);
        } else if(body){ body.appendChild(el); }
        else { frag.appendChild(el); }
      }
      var cards=frag.querySelectorAll ? frag.querySelectorAll('.bcard') : [];
      for(j=0;j<cards.length;j++){ var bd=cards[j].getElementsByClassName('bcard-body')[0];
        if(!bd || (bd.textContent||'').replace(/\s+/g,'')===''){
          cards[j].className+=' bcard-empty';
          if(bd){ bd.innerHTML='<span class="bcard-none">no entries yet</span>'; }
        }
      }
      host.innerHTML=''; host.appendChild(frag);
    })(hosts[i]); }
  }

  /* sequence page: collapse the Shipped section (collapsed by default once >8 items) */
  function collapseShipped(){
    var host=document.getElementById('seq-body'); if(!host) return;
    var hs=host.getElementsByTagName('h2'), i, target=null;
    for(i=0;i<hs.length;i++){ if((hs[i].textContent||'').replace(/^\s+|\s+$/g,'')==='Shipped'){ target=hs[i]; break; } }
    if(!target) return;
    var wrap=document.createElement('div'); wrap.className='shipped-wrap';
    var node=target.nextSibling, items=0, moved=[];
    while(node){ var nx=node.nextSibling;
      if(node.nodeType===1 && node.tagName==='H2') break;
      moved.push(node); node=nx;
    }
    for(i=0;i<moved.length;i++){ wrap.appendChild(moved[i]); if(moved[i].getElementsByClassName){ var lis=moved[i].getElementsByClassName('task'); items+=lis.length; } }
    var btn=document.createElement('button'); btn.type='button'; btn.className='u-btn-gild shipped-toggle';
    var collapsed=(items>8);
    function label(){ btn.textContent=(collapsed?'Show ':'Hide ')+items+' shipped'; }
    btn.onclick=function(){ collapsed=!collapsed; wrap.className='shipped-wrap'+(collapsed?' collapsed':''); label(); };
    if(collapsed) wrap.className+=' collapsed';
    label();
    target.parentNode.insertBefore(btn, target.nextSibling);
    btn.parentNode.insertBefore(wrap, btn.nextSibling);
  }

  function wireTicks(){
    var boxes=document.querySelectorAll('.ptick-box'), i;
    for(i=0;i<boxes.length;i++){ (function(box){
      var k='studio_ptick_'+box.getAttribute('data-key');
      box.checked=ls(k,false);
      box.onchange=function(){ sv(k,box.checked); };
    })(boxes[i]); }
  }
  function upgradeStrip(islands){
    var events=[], key;
    for(key in islands){ if(!islands.hasOwnProperty(key)) continue;
      if(key==='sequence.md'||key==='INDEX.md') continue;
      var slug=key.replace(/\.md$/,''), body=islands[key].replace(/\r\n/g,'\n');
      var seg=body.split(/\n##\s+Round history\s*\n/); if(seg.length<2) continue;
      var after=seg[1].split(/\n##\s+/)[0], rows=after.split('\n'), r;
      for(r=0;r<rows.length;r++){ var line=rows[r].replace(/^\s*[-*]\s+/,'').replace(/\s+$/,'');
        if(rows[r].match(/^\s*[-*]\s+/)&&line!==''){ events.push({slug:slug,text:line}); } }
    }
    if(!events.length) return;
    events.reverse();
    var strip=document.getElementById('recent-strip'); if(!strip) return;
    strip.innerHTML='<span class="rs-label">recent</span>';
    var n=Math.min(5,events.length), i;
    for(i=0;i<n;i++){ var sp=document.createElement('span'); sp.className='rs-item';
      sp.appendChild(document.createTextNode(events[i].slug+' · '+events[i].text)); strip.appendChild(sp); }
  }

  function showPage(){
    var h=location.hash||'#page-overview', id=h.replace(/^#/,'');
    var pages=document.querySelectorAll('.page'), i, found=false;
    for(i=0;i<pages.length;i++){ if(pages[i].id===id){ pages[i].className=addcls(pages[i].className,'active'); found=true; } else { pages[i].className=rmcls(pages[i].className,'active'); } }
    if(!found){ var ov=document.getElementById('page-overview'); if(ov){ ov.className=addcls(ov.className,'active'); } id='page-overview'; }
    var links=document.querySelectorAll('.brail-link');
    for(i=0;i<links.length;i++){ var href=links[i].getAttribute('href')||''; if(href==='#'+id){ links[i].className=addcls(links[i].className,'active'); } else { links[i].className=rmcls(links[i].className,'active'); } }
    window.scrollTo(0,0);
  }
  function addcls(c,x){ return (' '+c+' ').indexOf(' '+x+' ')>-1?c:(c?c+' '+x:x); }
  function rmcls(c,x){ return (' '+c+' ').replace(' '+x+' ',' ').replace(/^\s+|\s+$/g,''); }

  function boot(){
    var islands=collectIslands();
    paint(islands);
    cardify();
    collapseShipped();
    wireTicks();
    upgradeStrip(islands);
    showPage();
    window.onhashchange=showPage;
  }
  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded',boot); } else { boot(); }
})();
</script>
</body>
</html>
HTML

#!/bin/sh
# tools/studio-build -- Praxis Studio Builder generator (v2). EXTENSIONLESS on
# purpose (like tools/parse-check): the pre-commit hook treats any top-level *.js
# as served source that must ride a sw.js bump; this build tool is never served.
#
# Reads docs/studio/*.md and emits docs/studio/builder.html in full every run.
# The Light & Depth styling is NOT hand-copied here: docs/studio/universal-depth.css
# (Universal depth v1.2) is the single canonical source and is INLINED into the
# output at generation time. This generator carries only its own layout CSS.
# Edit the markdown (or universal-depth.css) and regenerate; never hand-edit builder.html.
#
# Usage:  sh tools/studio-build
# CWD-independent: paths are derived from the script's own location.

SDIR=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$SDIR/.." && pwd)
STUDIO="$REPO/docs/studio"
DEPTH="$STUDIO/universal-depth.css"
OUT="$STUDIO/builder.html"

# canonical surface order (18 routed + 4 overlay = 22)
SURFACES="home books book-detail book-marks artifact arcs arc-detail subtheory-page subtheory-build notebook account about profile commons reader walk search yumi-sees yumi-panel onboarding import-capture spotlight"

# --- ground-truth stamp values (baked at generation time) ---
HEAD=$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo '?')
CACHE=$(grep -oE "CACHE_VERSION *= *'[^']*'" "$REPO/sw.js" 2>/dev/null | head -1 | sed "s/.*'\(.*\)'/\1/")
[ -z "$CACHE" ] && CACHE='?'
NOW=$(date -u '+%Y-%m-%d %H:%M UTC')

# pull a frontmatter field: fm <file> <key>
fm() { grep -m1 "^$2:" "$1" | sed "s/^$2:[[:space:]]*//; s/^\"//; s/\"$//"; }

# state -> luminous-orb modifier classes (bright=closed, soft=building/shaped/scanned, unlit=untouched)
orbcls() {
  case "$1" in
    closed)   echo "u-orb--lit u-orb--amber";;
    building) echo "u-orb--soft u-orb--coral";;
    shaped)   echo "u-orb--soft u-orb--amber";;
    scanned)  echo "u-orb--soft u-orb--periwinkle";;
    *)        echo "u-orb--unlit";;
  esac
}

# imported gap-ledger finding count for a slug (0 when none / file missing)
gapcount() { c=$(grep -c '^- \[source: ' "$STUDIO/$1.md" 2>/dev/null); [ -z "$c" ] && c=0; echo "$c"; }

# the cross-cutting layer is a studio file but NOT one of the 22 surfaces
LAYERS="cross-cutting"

# --- progress numbers (closed surfaces / total; shipped steps) ---
set -- $SURFACES; TOTAL=$#
CLOSED=0
for s in $SURFACES; do st=$(fm "$STUDIO/$s.md" state); [ "$st" = "closed" ] && CLOSED=$((CLOSED+1)); done
SHIPPED=$(grep -cE '^- \[x\] ' "$STUDIO/sequence.md" 2>/dev/null); [ -z "$SHIPPED" ] && SHIPPED=0
PCT=0; [ "$TOTAL" -gt 0 ] && PCT=$((CLOSED*100/TOTAL))

{
# ---- banner + head + base tokens + layout CSS (block 1) ----
cat <<'HTML'

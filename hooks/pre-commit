#!/bin/sh
# Praxis commit gate — #5. Blocks a commit that violates a load-bearing invariant.
#
# Activate ONCE from the repo root:   git config core.hooksPath hooks
# Make executable (git bash):         chmod +x hooks/pre-commit
# Emergency bypass (use sparingly):   git commit --no-verify
#
# The BLOCKS below are structural and false-positive-free (they match staged
# filenames only). ES3 is a WARNING, not a block: regex on a raw diff false-
# positives on comments and strings, and a gate that wrongly stops a legit commit
# is a gate you disable. Real ES3 enforcement lives upstream (the parse-gate +
# the fix-red-team agent). See FIX-PROTOCOL.md §2 / §5.

staged=$(git diff --cached --name-only)
fail=0
emit() { echo "$1" >&2; }

# 1. Foundations are byte-locked — never commit them changed (match any path).
if printf '%s\n' "$staged" | grep -Eq '(^|/)lumen-amber\.css$'; then
  emit "BLOCK: lumen-amber.css is staged — it is byte-locked (FIX-PROTOCOL §2)."; fail=1
fi
if printf '%s\n' "$staged" | grep -Eq '(^|/)marks\.js$'; then
  emit "BLOCK: marks.js is staged — it is byte-locked (FIX-PROTOCOL §2)."; fail=1
fi

# 2. Never commit the throwaway test artifact.
if printf '%s\n' "$staged" | grep -Eq '(^|/)test-arc-constellation\.html$'; then
  emit "BLOCK: test-arc-constellation.html is staged — never commit it (FIX-PROTOCOL §2)."; fail=1
fi

# 3. A served-source change must ride a cache bump (sw.js in the same commit).
#    docs/, tools/, and design/ are exempt — build-time / reference files
#    (mockups, specs), never linked from index.html and never served to clients.
#    Root-level standalone HTML (scan-surface.html, scan-mockup.html,
#    scan-derisk.html, books-mockup.html, build-status.html — mockups, harnesses
#    and dashboards) is the same class: build-time-only and never precached — sw.js
#    APP_SHELL lists ONLY /index.html among root HTML — so it is exempt too. The awk
#    keeps a root-level *.html line ONLY when it is index.html (the served app shell,
#    which STAYS gated); every other root *.html is dropped from the served set.
src=$(printf '%s\n' "$staged" | grep -E '\.(js|css|html)$' | grep -Ev '(^|/)sw\.js$' | grep -Ev '^docs/' | grep -Ev '^tools/' | grep -Ev '^design/' | awk '$0 !~ /^[^\/]+\.html$/ || $0 == "index.html"')
if [ -n "$src" ]; then
  if ! printf '%s\n' "$staged" | grep -Eq '(^|/)sw\.js$'; then
    emit "BLOCK: source files staged without sw.js — bump CACHE_VERSION and stage sw.js (FIX-PROTOCOL §2)."
    emit "  staged source: $(printf '%s ' $src)"; fail=1
  fi
fi

# 4. ES3 WARNING (non-blocking) — flag likely violations in added JS lines.
es3=$(git diff --cached -- '*.js' 2>/dev/null | grep -E '^\+' | grep -Ev '^\+\+\+' \
      | grep -E '=>|`|\bconst[[:space:]]|\blet[[:space:]]|\bclass[[:space:]]+[A-Za-z_$]')
if [ -n "$es3" ]; then
  emit "WARN: possible ES3 violation(s) in added JS — verify (may be a comment/string):"
  printf '%s\n' "$es3" >&2
fi

# 5. AUTO-GUARD RAILS (blocking) — forbidden patterns in ADDED lines of CLIENT app
#    files ONLY: js/*.js and assets/*.css. tools/, docs/, *.md, sw.js and this hook
#    are OUT OF SCOPE by construction (they match neither pathspec) — tool scripts
#    use backticks/heredocs legitimately, so scoping to js/*.js + assets/*.css keeps
#    them clean. Each check below is fixture-proven fail-able AND false-positive-free
#    on the current tree (docs/studio/auto-guard.md). ES3-as-a-BLOCK and hex on an
#    edited legacy line are deliberately NOT blocks here — a raw-diff regex false-
#    positives on comments/strings/edited lines; that enforcement stays at the parse-
#    gate + fix-red-team (the same reason check #4 is a WARN, per FIX-PROTOCOL §2).

# 5a. Dynamic CSS-custom-property construction — the setProperty / string-concat seam.
#     Building a --var name at runtime is a forbidden seam (0 in the tree today). The
#     prose-string case (+ '-- word') is excluded by requiring a letter right after --.
jsadd=$(git diff --cached -- 'js/*.js' 2>/dev/null | grep -E '^\+' | grep -Ev '^\+\+\+')
seam=$(printf '%s\n' "$jsadd" | grep -nE "setProperty\([^,)]*\+|['\"]--[a-z][a-z-]*['\"][[:space:]]*\+|\+[[:space:]]*['\"]--[a-z][a-z-]*['\"]")
if [ -n "$seam" ]; then
  emit "BLOCK (auto-guard): dynamic CSS-var-name construction in added JS (setProperty / concat seam) — use a static token name."
  printf '%s\n' "$seam" | sed 's/^/  js: /' >&2; fail=1
fi

# 5b. New hardcoded hex color in client CSS OUTSIDE theme.css (the tokens-only rule).
#     Value-context only (:...#hex) so #id selectors do not trip it. theme.css is the
#     sanctioned home for hex literals and is excluded. Editing a legacy line that
#     already carries a hex re-flags it — a nudge to tokenize; --no-verify (with a
#     one-line reason) is the sanctioned escape for a genuine legacy-line edit.
cssadd=$(git diff --cached -- 'assets/*.css' ':(exclude)assets/theme.css' 2>/dev/null | grep -E '^\+' | grep -Ev '^\+\+\+')
hex=$(printf '%s\n' "$cssadd" | grep -nE ":[^;{}]*#[0-9a-fA-F]{3,8}([^0-9a-fA-F]|$)")
if [ -n "$hex" ]; then
  emit "BLOCK (auto-guard): hardcoded hex color added outside theme.css — use a var(--token) (CLAUDE.md conventions)."
  printf '%s\n' "$hex" | sed 's/^/  css: /' >&2; fail=1
fi

# 5c. New EXTERNAL DEPENDENCY in client app files (S-B SWEEP, 2026-08-08). Praxis is a
#     no-build, ES3, vanilla, zero-dependency static site — a vendored dep or an externally
#     loaded resource is a deliberate REVIEW event, never a silent add. JS arm: a module
#     loader — a line-initial `import` statement, `import(...)`, `require('...')`, or
#     `importScripts(...)` — all 0 in the ES3 tree today (no bundler, no modules). CSS arm:
#     an `@import` or an external `url(http…)` in a NON-foundations sheet. lumen-amber.css
#     carries the one sanctioned Google-Fonts `@import` and is byte-locked by check #1, so it
#     is EXCLUDED here (like theme.css is excluded from 5b). Both arms fixture-proven
#     fail-able AND false-positive-free on the current tree (docs/studio/auto-guard.md).
depjs=$(printf '%s\n' "$jsadd" | grep -nE "^\+[[:space:]]*import[[:space:]]|[^A-Za-z0-9_.]import[[:space:]]*\([[:space:]]*['\"]|[^A-Za-z0-9_.]require[[:space:]]*\([[:space:]]*['\"]|[^A-Za-z0-9_.]importScripts[[:space:]]*\(")
if [ -n "$depjs" ]; then
  emit "BLOCK (auto-guard): new external dependency in added JS (import / require / importScripts) — Praxis is a no-build ES3 site; a vendored dep is a review event, not a silent add."
  printf '%s\n' "$depjs" | sed 's/^/  js: /' >&2; fail=1
fi
cssdepadd=$(git diff --cached -- 'assets/*.css' ':(exclude)assets/lumen-amber.css' 2>/dev/null | grep -E '^\+' | grep -Ev '^\+\+\+')
cssdep=$(printf '%s\n' "$cssdepadd" | grep -nE "@import|url\([[:space:]]*['\"]?https?:")
if [ -n "$cssdep" ]; then
  emit "BLOCK (auto-guard): new external resource in added CSS (@import / external url(http…)) outside the byte-locked foundations sheet — inline it or load a local asset."
  printf '%s\n' "$cssdep" | sed 's/^/  css: /' >&2; fail=1
fi

if [ "$fail" -ne 0 ]; then
  emit ""
  emit "Commit blocked by the Praxis gate. Fix the above, or 'git commit --no-verify' to bypass in an emergency."
  exit 1
fi
exit 0

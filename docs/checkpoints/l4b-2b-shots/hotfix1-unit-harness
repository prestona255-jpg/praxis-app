    add: function (c) { if (!this.contains(c)) { self.className = self.className ? (self.className + ' ' + c) : c; } },
    remove: function (c) { var p = self.className.split(' '), o = [], i; for (i = 0; i < p.length; i++) { if (p[i] && p[i] !== c) { o.push(p[i]); } } self.className = o.join(' '); }

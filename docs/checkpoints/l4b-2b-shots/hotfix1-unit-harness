function kids(el) { return (el.innerHTML === '') ? [] : el.children; }   // innerHTML = '' cleared them
function all(el, out) { var i, k = kids(el); out = out || []; for (i = 0; i < k.length; i++) { out.push(k[i]); all(k[i], out); } return out; }
